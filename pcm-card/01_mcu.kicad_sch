	(text "USB-only programming: remove the card from CM-64. Start with ARM=0, DATA_OE_N=1 and all strobes HIGH.\nLoad all 24 address bits before ARM=1. Wait >=100 us after arming. Deassert ARM before USB disconnect."
		(exclude_from_sim no)
		(at 15 260 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "540376c1-bd25-5780-bc62-61531ae906dd")
	)
	(text "GPIO0..7=data; GPIO16/17/18=595 serial/clock/latch. Firmware is not in the PLAY path."
