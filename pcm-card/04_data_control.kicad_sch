	(text "HOST_DATA_OE_N = PLAY_EN_N OR HOST_CE_N OR HOST_OE_N. Flash WE_N has a separate pull-up on sheet 02.\nPROGRAM direction changes: DATA_OE_N=1 and CE_N/OE_N/WE_N=1; wait for U12 AND flash outputs to reach Hi-Z.\nREAD: MCU_D=input, DIR=0, then enable U12 and flash. WRITE: keep OE_N=1, set DIR=1 and MCU_D outputs, then enable U12.\nFirmware must prevent simultaneous U12 MCU->flash drive and flash read drive. This is not hardware-interlocked."
  (exclude_from_sim no)
  (at 15 265 0)
  (effects
    (font
      (size 1.1 1.1)
    )
    (justify left top)
  )
  (uuid "95ad42f8-e3d5-5379-b5b5-afeb88ea4fa8")
)
