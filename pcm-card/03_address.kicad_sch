	(text "SW1 is a 16-position hexadecimal coded switch, not an incremental encoder. Select banks only with ALL power off.\nSW1 contact signals can reach 5V; U7 accepts 5V and shifts down to 3.3V. U8 Q0 is intentionally unused."
		(exclude_from_sim no)
		(at 15 263 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "61256d70-29a0-53ca-8423-2d9971d4bd9b")
	)
	(text "Only one address source may drive the flash. PLAY_EN_N and PROG_EN_N are hardware-generated.\n595 serial order: A0 -> A1 -> ... -> A22 -> 0 (24 clocks, LSB-first); pulse LATCH only after all 24 bits.\nKeep MCU_ARM=0 until the first address is latched and CE_N/OE_N/WE_N are HIGH. MR_N does not clear the output latch."
  (exclude_from_sim no)
  (at 15 18 0)
  (effects
    (font
      (size 1.3 1.3)
    )
    (justify left top)
  )
  (uuid "dc561aab-7b19-5d79-83f3-620ab85d844e")
)
