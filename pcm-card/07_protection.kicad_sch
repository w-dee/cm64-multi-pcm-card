	(text "Eight low-capacitance 4-channel arrays at card contacts; one at USB D+/D-/CC1/CC2; one VBUS TVS.\nPCB copper connects pads 10-1, 9-2, 7-4 and 6-5 for straight-through routing (no internal connection)."
		(exclude_from_sim no)
		(at 15 18 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "562bb7e2-d22c-50b0-939c-01e4e16526f8")
	)
	(text "TVS ground returns must be short and wide. Do not place the ESD return current path through MCU/flash ground necks.\nTVS channels follow J3 pin order: U24.1 protects pin 1 HOST_5V; U31.5 protects pin 34 SENS (same net).\nMechanical card thickness, insertion depth, pin numbering and contact-side orientation remain provisional."
		(exclude_from_sim no)
		(at 15 261 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "af5def92-a893-58e2-b916-fbc16c2fa983")
	)
