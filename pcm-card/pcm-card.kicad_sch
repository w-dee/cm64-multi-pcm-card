  )
  (uuid "652a5c0e-8c94-58a5-8176-ac445906797b")
)
	(text "OPERATING RULES\nRemove card from CM-64 for USB programming.\nNever insert, remove, change bank, or switch host power during programming.\nChange SW1 only with all power off.\nReturn NOR to read-array mode and verify data before disconnecting USB."
		(exclude_from_sim no)
		(at 205 201 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "6e84ec07-fbb5-5ddf-a5cc-e39696a6e61a")
	)
	(text "64 Mbit parallel NOR / 16 x 512 KiB banks / RP2040 USB programmer"
		(exclude_from_sim no)
		(at 15 16 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "6e99a252-9c4f-5621-a950-76bd935bb31c")
	)
	(text "READ BEFORE PCB FABRICATION\nCard edge is provisional: 34 contacts / 1.50 mm pitch, not a verified SN-U110 mechanical specification.\nConfirm flash sourcing (C2944625 was out of stock), host timing, host power budget and component heights.\nNative KiCad ERC and fabrication/assembly review remain required. See README_JA.md and verification_report.md."
		(exclude_from_sim no)
		(at 20 247 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "96ce4bfe-ee50-563f-bfcd-e828c5a14b88")
	)
	(text "MODES\nHOST only: PLAY, MCU held in reset.\nUSB only: PROGRAM standby; MCU_ARM explicitly enables the programmer.\nHOST + USB: PLAY priority, hardware write inhibit.\nNo power: all off."
		(exclude_from_sim no)
		(at 20 201 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "a19d5664-d146-5c8a-9068-c1853882e5cd")
	)
